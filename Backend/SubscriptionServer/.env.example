APP_ENV=development
PUBLIC_URL=https://example.com/subscriptions
BILLING_NAMESPACE=replace-with-a-unique-installation-id
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=subscription_game
DB_USERNAME=subscription_app
DB_PASSWORD="change-this"
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=86400
MAIL_TRANSPORT=log
MAIL_FROM=accounts@example.com
MAIL_FROM_NAME="My Game"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=
ALLOW_LIVE_PAYMENTS=false
# Change to your private catalog file after copying games.example.php.
GAME_CATALOG=config/games.php
